# Public browser key; safe to expose in the client.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-your-public-key

# Server-only credentials. Never commit actual values or expose them to the browser.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-access-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
DASHBOARD_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
